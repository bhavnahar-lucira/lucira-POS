# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local config — accumulates real command history (including
# credentials typed into live-testing curl commands) in its permission
# allowlist. Never committed: a real OrnaVerse admin credential leaked into
# git history via .claude/settings.json on 2026-08-06/10/12 before this
# rule existed — scrubbed from history on 2026-09-18 via git-filter-repo.
# settings.local.json is also covered by a global gitignore rule already,
# but listed here too so this repo is safe regardless of whose
# machine/global config it's cloned onto.
.claude/

# Playwright MCP live-testing artifacts (console logs, page snapshots) —
# accumulates real captured network/session data from live-testing against
# OrnaVerse's own production tenant. Local scratch only, never committed.
.playwright-mcp/
